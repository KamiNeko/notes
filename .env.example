# Copy to .env and fill in. Never commit .env.

# Database password (a long random string, e.g. `openssl rand -hex 24`)
POSTGRES_PASSWORD=

# First administrator, created on the first start (password: at least 12 characters).
# Remove both lines once you have signed in;
# further users are added in the app (account menu > Manage users) or with the CLI.
NOTES_ADMIN_EMAIL=
NOTES_ADMIN_PASSWORD=

# Host port the app is published on
HOST_PORT=8080

# The URL you open in the browser. With https:// the session cookie is marked Secure.
# NOTES_PUBLIC_URL=https://notes.example.com
# Behind a reverse proxy (Nginx Proxy Manager, Traefik, Caddy, ...)
# NOTES_TRUST_PROXY=true
# Addresses/CIDR ranges the proxy connects from (default: loopback and private networks)
# NOTES_TRUSTED_PROXIES=192.168.1.10

# Delete versions older than this many days (0 keeps all)
# NOTES_VERSION_RETENTION_DAYS=0
# Empty the trash: delete notes and notebooks trashed more than this many days ago (0 keeps them)
# NOTES_TRASH_RETENTION_DAYS=0
# Delete attachments no note, trashed note or version links to, this many days after upload (0 keeps them)
# NOTES_ATTACHMENT_CLEANUP_DAYS=0
# Largest attachment in MB
# NOTES_MAX_UPLOAD_MB=25
# Attachment space per user in MB (0 is unlimited; administrators can override it per user)
# NOTES_QUOTA_MB=0
# Largest ZIP accepted by the import in MB (raise the proxy's body size limit to match)
# NOTES_MAX_IMPORT_MB=200
# Show images from other websites in notes
# NOTES_ALLOW_REMOTE_IMAGES=false
