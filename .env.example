# Copy to .env and fill in. Never commit .env.

# Database password (any long random string, e.g. `openssl rand -hex 24`)
POSTGRES_PASSWORD=

# First administrator, created on the first start. You can remove both lines afterwards;
# further users are added in the app (account menu > Manage users) or with the CLI.
NOTES_ADMIN_EMAIL=
NOTES_ADMIN_PASSWORD=

# Host port the app is published on
HOST_PORT=8080

# The URL you open in the browser. With https:// the session cookie is marked Secure.
# NOTES_PUBLIC_URL=https://notes.example.com
# Behind a reverse proxy (Nginx Proxy Manager, Traefik, Caddy, ...)
# NOTES_TRUST_PROXY=true

# Delete versions older than this many days (0 keeps all)
# NOTES_VERSION_RETENTION_DAYS=0
# Largest attachment in MB
# NOTES_MAX_UPLOAD_MB=25
# Show images from other websites in notes
# NOTES_ALLOW_REMOTE_IMAGES=false
